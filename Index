  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#07111f;
      --panel:#0b1728;
      --card:#0f1f36;
      --text:#eaf2ff;
      --muted:#b4c4dd;
      --brand:#5aa7ff;
      --brand2:#2dd4bf;
      --line:rgba(255,255,255,.1);
      --shadow:0 24px 70px rgba(0,0,0,.35);
      --radius:26px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Inter,system-ui,sans-serif;
      background:radial-gradient(circle at top,#10233f 0,var(--bg) 44%);
      color:var(--text);
      line-height:1.6;
    }
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}
    .wrap{width:min(1160px,calc(100% - 32px));margin:0 auto}
    .topbar{
      position:sticky;top:0;z-index:30;
      background:rgba(7,17,31,.78);
      backdrop-filter:blur(14px);
      border-bottom:1px solid var(--line);
    }
    .nav{
      display:flex;align-items:center;justify-content:space-between;gap:16px;
      padding:14px 0;
    }
    .brand{display:flex;align-items:center;gap:12px;font-weight:800}
    .logo{
      width:46px;height:46px;border-radius:15px;
      background:linear-gradient(135deg,var(--brand),var(--brand2));
      display:grid;place-items:center;color:#04111f;font-weight:900;
      box-shadow:var(--shadow);
    }
    .menu{display:flex;gap:18px;flex-wrap:wrap;color:var(--muted);font-size:.95rem}
    .cta{display:flex;gap:10px;flex-wrap:wrap}
    .btn{
      padding:12px 18px;border-radius:999px;font-weight:700;
      border:1px solid var(--line);background:rgba(255,255,255,.04);
    }
    .btn.primary{
      background:linear-gradient(135deg,var(--brand),var(--brand2));
      color:#03131f;border:none;
    }
    .hero{padding:74px 0 22px}
    .grid{
      display:grid;grid-template-columns:1.15fr .85fr;gap:22px;align-items:stretch;
    }
    .kicker{
      display:inline-flex;gap:8px;align-items:center;padding:8px 14px;
      border-radius:999px;background:rgba(255,255,255,.06);border:1px solid var(--line);
      color:#d9e7ff;font-size:.94rem;
    }
    .hero h1{
      font-size:clamp(2.4rem,5vw,5rem);
      line-height:1.02;margin:18px 0 14px;
    }
    .hero p{color:var(--muted);font-size:1.08rem;max-width:62ch}
    .pillrow{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0}
    .pill{
      padding:10px 14px;border-radius:999px;
      background:rgba(255,255,255,.06);border:1px solid var(--line);
      color:#d7e4fb;font-size:.95rem;
    }
    .card{
      background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.03));
      border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);
    }
    .heroCard{padding:24px}
    .stats{
      display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:18px;
    }
    .stat{
      padding:16px;border-radius:20px;background:rgba(8,17,31,.55);border:1px solid var(--line);
    }
    .stat b{display:block;font-size:1.18rem}
    .stat span{color:var(--muted);font-size:.92rem}
    section{padding:22px 0 0}
    .sectionTitle{font-size:1.8rem;margin:0 0 14px}
    .services{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .svc,.info,.contactBox,.faqItem{padding:22px}
    .svc h3,.info h3,.contactBox h3{margin:.15rem 0 .5rem}
    .svc p,.info p,.contactBox p,.faqItem p{color:var(--muted);margin:0}
    .icon{
      width:50px;height:50px;border-radius:16px;
      background:rgba(90,167,255,.15);display:grid;place-items:center;
      font-size:1.2rem;margin-bottom:14px;
    }
    .twoCol{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .list ul{margin:0;padding-left:18px;color:var(--muted)}
    .locations{display:flex;flex-wrap:wrap;gap:10px}
    .tag{
      padding:10px 14px;border-radius:999px;background:rgba(255,255,255,.05);
      border:1px solid var(--line);color:#dbe7ff;font-size:.94rem;
    }
    .contact{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .form{display:grid;gap:12px}
    .field{
      padding:14px 16px;border-radius:16px;border:1px solid var(--line);
      background:rgba(255,255,255,.04);color:var(--text)
    }
    .field::placeholder{color:#90a3c4}
    textarea.field{min-height:140px;resize:vertical}
    .faq{display:grid;gap:12px}
    .faqItem details{
      border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.04);padding:16px 18px;
    }
    .faqItem summary{cursor:pointer;font-weight:700}
    .faqItem p{padding-top:10px}
    .stickybar{
      position:fixed;left:0;right:0;bottom:0;background:rgba(7,17,31,.88);
      backdrop-filter:blur(14px);border-top:1px solid var(--line);padding:10px 0;z-index:40;
    }
    .stickybar .wrap{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
    footer{padding:28px 0 84px;color:var(--muted);font-size:.94rem}
    .small{font-size:.92rem;color:var(--muted)}
    @media (max-width:900px){
      .grid,.services,.twoCol,.contact{grid-template-columns:1fr}
      .menu{display:none}
      .hero{padding-top:42px}
      .stats{grid-template-columns:1fr 1fr}
    }
    @media (max-width:560px){
      .stats{grid-template-columns:1fr}
      .hero h1{font-size:2.35rem}
      .cta,.pillrow{width:100%}
      .btn{flex:1;text-align:center}
    }
  </style>
